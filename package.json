{
  "name": "club-portal",
  "version": "1.0.0",
  "description": "Professional Club Management & Public Verification Portal",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"npm run dev --prefix client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "seed": "node server/seed.js",
    "start": "node server/index.js"
  },
  "keywords": ["club", "portal", "verification", "qr", "members"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4"
  }
}
