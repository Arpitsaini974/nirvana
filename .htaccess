# ================================================================
# NIRVANA WEB PLATFORM — HOSTINGER APACHE & SPA ROUTING (.htaccess)
# ================================================================

# Disable directory listing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------
  # CRITICAL: Pass Authorization Header to PHP on Shared Hosting
  # (Prevents Hostinger Apache from stripping Bearer tokens)
  # --------------------------------------------------------------
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # --------------------------------------------------------------
  # 1. API Requests -> Route to PHP Front Controller
  # --------------------------------------------------------------
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # --------------------------------------------------------------
  # 2. Existing Files & Directories (Assets, Images, Uploads, etc.)
  # --------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --------------------------------------------------------------
  # 3. React SPA Fallback: Route all other requests to index.html
  # --------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------
# Security: Block direct access to database files & sensitive configs
# ----------------------------------------------------------------
<FilesMatch "\.(sql|db|sqlite|log|ini|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ----------------------------------------------------------------
# Performance: Gzip Compression
# ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------
# Performance: Browser Caching
# ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
